# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_atlas_uri_here

# Telegram order bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
# Chat id that receives order notifications (message the bot, then fetch your id)
TELEGRAM_CHAT_ID=your_chat_id
# Secret token Telegram sends with every webhook call
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
# Public URL of this site's webhook endpoint (set after deploying)
TELEGRAM_WEBHOOK_URL=

# Password required to access /admin
ADMIN_PASSWORD=your_secure_admin_password
